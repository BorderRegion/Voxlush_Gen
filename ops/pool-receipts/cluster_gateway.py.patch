+def routing(request):
+    """Pinned named subsets preserve legacy ID placement and receipt lookup."""
+    name=request.match_info.get('pool_name')
+    if name is None:return NODES,None,str(request.rel_url)
+    spec=CONFIG.get('model_pools',{}).get(name)
+    if not isinstance(spec,dict) or not spec.get('nodes') or not spec.get('models'):
+        raise ValueError('Unknown or invalid model pool')
+    by_id={n['id']:n for n in NODES}
+    ids=spec['nodes']
+    if len(set(ids))!=len(ids) or any(i not in by_id for i in ids):
+        raise ValueError('Invalid pinned model pool workers')
+    path=str(request.rel_url).replace('/v1/pools/'+name+'/', '/v1/', 1)
+    return [by_id[i] for i in ids],set(spec['models']),path
+
