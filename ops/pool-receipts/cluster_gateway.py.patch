+    def reject(message, status=503):
+        response = error(message, status)
+        rid = request.headers.get('X-Pool-Request-Id', '')
+        if len(rid) == 32 and all(c in '0123456789abcdef' for c in rid):
+            response.headers.update({'X-Pool-Request-Id':rid, 'X-Pool-Receipt-Version':'pool.receipt.v1',
+                                     'X-Pool-Execution-State':'not_sent'})
+        return response
+    if not authorized(request):return reject('invalid pool credential',401)
