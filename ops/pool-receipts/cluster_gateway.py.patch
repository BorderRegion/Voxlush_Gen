+async def receipt_query(request):
+    if not authorized(request):return error('invalid pool credential',401)
+    rid=request.match_info['request_id']
+    if len(rid)!=32 or any(c not in '0123456789abcdef' for c in rid):
+        return error('invalid request identity',400)
+    try:nodes,_,path=routing(request)
+    except ValueError as exc:return error(str(exc),404)
+    node=nodes[int(rid,16)%len(nodes)]
+    try:
+        async with request.app['session'].get(node['url']+path,headers={'Authorization':request.headers['Authorization']},timeout=ClientTimeout(total=10)) as upstream:
+            chunks=[];size=0
+            async for chunk in upstream.content.iter_chunked(65536):
+                size+=len(chunk)
+                if size>16*1024*1024:return error('receipt byte limit',502)
+                chunks.append(chunk)
+            body=b''.join(chunks)
+            return web.Response(status=upstream.status,body=body,headers={'Content-Type':upstream.headers.get('Content-Type','application/json'),'Cache-Control':'no-store'})
+    except Exception:
+        return error('receipt worker unavailable; execution remains unknown',502)
+
