+    def relay_receipted(self, response):
+        receipt = self.receipt
+        receipt.headers(response)
+        is_stream = 'text/event-stream' in response.headers.get('Content-Type','')
+        connected = True
+        failure = None
+        accumulator = UsageAccumulator()
+        self.response_started = True
+        try:
+            self.send_response(response.status_code)
+            self.copy_headers(response.headers)
+            self.send_header('Transfer-Encoding','chunked')
+            self.send_header('X-Pool-Request-Id', receipt.id)
+            self.send_header('X-Pool-Receipt-Version', 'pool.receipt.v1')
+            self.send_header('X-Accel-Buffering','no')
+            self.end_headers()
+        except (OSError,ConnectionError):
+            connected = False
+            receipt.disconnected()
+        def write(chunk):
+            nonlocal connected
+            if connected:
+                try:
+                    self.wfile.write(f'{len(chunk):X}\r\n'.encode() + chunk + b'\r\n')
+                    self.wfile.flush()
+                except (OSError,ConnectionError):
+                    connected = False
+                    receipt.disconnected()
+        try:
+            for chunk in response_chunks(response, self.request_deadline):
+                if chunk is None:
+                    if is_stream:
+                        write(b': pool heartbeat\n\n')
+                    continue
+                receipt.chunk(chunk, stream=is_stream)
+                write(chunk)
+        except Exception as exc:
+            failure = type(exc).__name__
+            self.close_connection = True
+        finally:
+            receipt.end(failure, stream=is_stream)
+        if connected and failure is None:
+            try:
+                self.wfile.write(b'0\r\n\r\n')
+                self.wfile.flush()
+            except (OSError,ConnectionError):
+                receipt.disconnected()
+        # Preserve existing aggregate token accounting; currency remains unknown
+        # in the receipt unless the upstream provides a separately verifiable bill.
+        if receipt.data.get('usage'):
+            accumulator.absorb({'usage':receipt.data['usage']})
+        return accumulator.result(), receipt.data['response_complete']
+
